# Public browser token used only for the interactive delivery street map.
# Mapbox public tokens begin with pk. Never put a secret sk. token here.
VITE_MAPBOX_ACCESS_TOKEN=

# Stripe PUBLISHABLE test key (starts with pk_test_). Safe for the browser.
# Never put the secret sk_ key here. Leave empty to use the built-in test card form.
VITE_STRIPE_PUBLISHABLE_KEY=

# PayPal needs nothing here. Put PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET in backend/.env;
# the backend hands the public client ID to the page, and the secret never reaches the browser.
