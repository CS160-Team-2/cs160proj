# Copy this file to .env in this folder (never commit .env).

# MySQL server address.
MYSQL_HOST=127.0.0.1
# MySQL server port.
MYSQL_PORT=3306
# MySQL user created by schema.sql.
MYSQL_USER=cs160team2
# Password of that MySQL user.
MYSQL_PASSWORD=team2_password
# Database the app uses.
MYSQL_DATABASE=ofs

# Port Flask listens on (not 5000, which macOS uses for AirPlay).
FLASK_PORT=5001

# Address of the website that may call the API; must match the Vite address exactly.
FRONTEND_ORIGIN=http://localhost:5173

# Signs the sign-in cookie; use your own long random value anywhere except your laptop.
SECRET_KEY=dev-only-secret-change-me

# Set to 1 on HTTPS so the sign-in cookie is sent only over HTTPS (needs your own SECRET_KEY).
# SESSION_COOKIE_SECURE=1

# How many proxies (such as Apache) sit in front of Flask, so rate limits see each visitor.
# TRUSTED_PROXIES=1

# Length of the rate-limit window in seconds.
# RATE_LIMIT_WINDOW_SECONDS=600
# Wrong passwords allowed per account and connection.
# RATE_LIMIT_SIGN_IN=8
# Wrong passwords allowed from one connection across all accounts.
# RATE_LIMIT_SIGN_IN_PER_ADDRESS=30
# Order look-ups that find nothing.
# RATE_LIMIT_ORDER_LOOKUP=10
# Wrong passwords allowed when changing a password or deleting an account.
# RATE_LIMIT_PASSWORD_CHECK=5
# Set to 0 to turn the rate limits off.
# RATE_LIMIT_ENABLED=1

# Days a guest's cart and a customer's sign-in last after their last visit.
# CART_SESSION_DAYS=14

# Card payments: fake (works offline) or stripe.
PAYMENT_GATEWAY=fake
# Stripe secret TEST key, used when the gateway is stripe.
# STRIPE_SECRET_KEY=sk_test_...
# Currency of card payments.
# STRIPE_CURRENCY=usd
# Set to 1 to allow live Stripe keys (refused otherwise).
# STRIPE_ALLOW_LIVE=0

# PayPal sandbox Client ID (public); leave empty to turn PayPal off.
PAYPAL_CLIENT_ID=
# PayPal sandbox Secret (private; backend only).
PAYPAL_CLIENT_SECRET=
# PayPal environment: sandbox or live.
# PAYPAL_ENV=sandbox
# Currency of PayPal payments.
# PAYPAL_CURRENCY=USD

# Map service: fake (offline), google or mapbox.
MAP_PROVIDER=fake
# Google key (needs the Geocoding and Routes APIs).
# GOOGLE_MAPS_API_KEY=
# Mapbox access token.
# MAPBOX_ACCESS_TOKEN=

# How deliveries are handed to vehicles: simulated.
VEHICLE_LINK=simulated
# Seconds the simulated robot takes per stop after dispatch; 0 means stops are only completed when reported.
VEHICLE_SIMULATION_SECONDS=20

# Farthest an address may be from the store, in straight-line miles.
SERVICE_RADIUS_MILES=25
