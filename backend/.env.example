# Copy this file to  .env  in the same folder, then fill in your password.
#   macOS / Linux :  cp .env.example .env
#   Windows       :  copy .env.example .env
#
# .env is listed in .gitignore and must never be committed.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cs160team2
MYSQL_PASSWORD=team2_password
MYSQL_DATABASE=ofs

# Flask listens here. 5001 rather than Flask's usual 5000 because
# macOS Monterey and later use port 5000 for AirPlay Receiver.
FLASK_PORT=5001

# Origin the Vite dev server runs on. Must match exactly — including the
# port — or the browser will block every request with a CORS error.
FRONTEND_ORIGIN=http://localhost:5173

# Signs the sign-in cookie. Any long random string; must be set to
# something private anywhere other than your own laptop.
SECRET_KEY=dev-only-secret-change-me

# Days a guest's cart and a customer's sign-in last after their last visit.
# Every visit extends it. Staff sessions end when the browser closes.
# CART_SESSION_DAYS=14

# Outside services. "fake" works offline and is what the tests use.
PAYMENT_GATEWAY=fake            # or stripe, with a TEST secret key below
# STRIPE_SECRET_KEY=sk_test_... # Stripe dashboard > Developers > API keys
# STRIPE_CURRENCY=usd
# Live keys (sk_live_...) are refused unless this is set to 1:
# STRIPE_ALLOW_LIVE=0

# PayPal (optional). Create a Sandbox app at developer.paypal.com, then copy its Client ID and Secret.
# Both set = the checkout page offers PayPal. Sandbox only unless PAYPAL_ENV=live and PAYPAL_ALLOW_LIVE=1.
# Client ID (public, also sent to the browser by /api/payments/config). Leave empty to turn PayPal off.
PAYPAL_CLIENT_ID=
# Secret (private: backend only, never commit it, never put it in frontend/.env).
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# PAYPAL_CURRENCY=USD
MAP_PROVIDER=fake            # or google / mapbox, with a server-side key below
# Google provider requires both Geocoding API and Routes API.
# GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=
VEHICLE_LINK=simulated
# For demos: the simulated robot delivers one stop every N seconds after
# dispatch. 0 means stops are only completed when reported.
VEHICLE_SIMULATION_SECONDS=20
