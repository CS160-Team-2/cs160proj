# Copy this file to  .env  in the same folder, then fill in your password.
#   macOS / Linux :  cp .env.example .env
#   Windows       :  copy .env.example .env
#
# .env is listed in .gitignore and must never be committed.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cs160team2
MYSQL_PASSWORD=team2_password
MYSQL_DATABASE=ofs

# Flask listens here. 5001 rather than Flask's usual 5000 because
# macOS Monterey and later use port 5000 for AirPlay Receiver.
FLASK_PORT=5001

# Origin the Vite dev server runs on. Must match exactly — including the
# port — or the browser will block every request with a CORS error.
FRONTEND_ORIGIN=http://localhost:5173

# Signs the sign-in cookie. Any long random string; must be set to
# something private anywhere other than your own laptop.
SECRET_KEY=dev-only-secret-change-me

# Outside services. "fake" works offline and is what the tests use.
PAYMENT_GATEWAY=fake
MAP_PROVIDER=fake            # or google / mapbox, with a key below
# GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=
VEHICLE_LINK=simulated
# For demos: the simulated robot delivers one stop every N seconds after
# dispatch. 0 means stops are only completed when reported.
VEHICLE_SIMULATION_SECONDS=20
