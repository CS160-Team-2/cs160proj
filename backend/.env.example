# Copy this file to  .env  in the same folder, then fill in your password.
#   macOS / Linux :  cp .env.example .env
#   Windows       :  copy .env.example .env
#
# .env is listed in .gitignore and must never be committed.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cs160team2
MYSQL_PASSWORD=team2_password
MYSQL_DATABASE=ofs

# Flask listens here. 5001 rather than Flask's usual 5000 because
# macOS Monterey and later use port 5000 for AirPlay Receiver.
FLASK_PORT=5001

# Origin the Vite dev server runs on. Must match exactly — including the
# port — or the browser will block every request with a CORS error.
FRONTEND_ORIGIN=http://localhost:5173
