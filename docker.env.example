# Optional settings for the Docker setup. Copy this file to .env next to compose.yaml; with no .env everything still runs, using fake payments and a fake map.

# Port of the website on your computer.
OFS_PORT=8088

# Signs the sign-in cookie; use your own long random value on any shared computer.
SECRET_KEY=dev-only-secret-change-me

# Seconds the simulated vehicle takes per stop after dispatch.
VEHICLE_SIMULATION_SECONDS=20

# Card payments: fake or stripe.
PAYMENT_GATEWAY=fake
# Stripe secret TEST key, used when the gateway is stripe.
STRIPE_SECRET_KEY=
# Stripe publishable TEST key (pk_test_...), baked into the site when it is built.
STRIPE_PUBLISHABLE_KEY=

# PayPal sandbox keys; leave empty to turn PayPal off.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Map service: fake, mapbox or google.
MAP_PROVIDER=fake
# Mapbox public token (pk.), used by the backend and baked into the site when it is built.
MAPBOX_ACCESS_TOKEN=
# Google key, only with MAP_PROVIDER=google.
GOOGLE_MAPS_API_KEY=
